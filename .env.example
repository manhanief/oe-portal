# Copy this file to .env and change the passwords.
# Use only letters, numbers and underscores in passwords
# (symbols like @ / " break Oracle connection strings).
# Never commit .env to Git.

# Oracle SYS/SYSTEM password (set when the database is first created)
ORACLE_PWD=OePortal_2026

# Password for the RESTO application user
RESTO_PWD=Resto_2026

# First admin account for the staff pages (created only when there are no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin_2026

# Ports on your Mac
WEB_PORT=8080
ORACLE_PORT=1522

TZ=Asia/Kuala_Lumpur
